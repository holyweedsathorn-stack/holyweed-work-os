# Copy this file to .env.local and fill in your Supabase project's values.
# Project Settings → API in the Supabase dashboard has all three.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used by `npm run seed` (server-side, never sent to the browser).
# Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional — override the demo owner login created by the seed script.
SEED_OWNER_EMAIL=owner@holyweed.co
SEED_OWNER_PASSWORD=holyweed-demo-2026

# --- Live Silom POS sync (src/app/api/cron/silom-sync/route.ts) ---------
# Silom has no API, so this logs into each shop's Silom dashboard account
# on a schedule and reads the live numbers off it. These are two SEPARATE
# Silom accounts (one per shop) -- set all four. Add these in Vercel's
# Project Settings -> Environment Variables, not in a file that gets
# committed anywhere.
SILOM_SATHORN_EMAIL=
SILOM_SATHORN_PASSWORD=
SILOM_SUKHUMVIT_EMAIL=
SILOM_SUKHUMVIT_PASSWORD=

# Optional but recommended -- without it, /api/cron/silom-sync is a public
# URL anyone could hit to trigger a login against your Silom accounts.
# Vercel sends this automatically as a Bearer token once it's set here.
CRON_SECRET=

# --- Holy Hostel PMS link (src/lib/pms.ts) ------------------------------
# Lets the clock screen list today's PMS arrivals and check guests in/out
# on the PMS too. PMS_API_URL is the PMS site's address (no trailing path);
# PMS_API_SECRET must be the SAME value as WORKOS_API_SECRET in the PMS's
# Vercel project. Server-side only -- never prefix with NEXT_PUBLIC_.
# Leave both empty and the hostel section works by hand, as before.
PMS_API_URL=
PMS_API_SECRET=
